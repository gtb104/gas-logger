{
  "name": "Gas Logger",
  "short_name": "Gas Log",
  "description": "Track vehicle fill-ups, mileage, and fuel costs.",
  "start_url": "/fillup",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f8fb",
  "theme_color": "#4682b4",
  "orientation": "portrait",
  "icons": [
